# BIS SmartAssist - Environment Configuration

# Project
PROJECT_NAME="BIS SmartAssist"
VERSION="1.0.0"

# Application Security
SECRET_KEY="bis-smartassist-secret-sih26107-token-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./bis_smartassist.db"
# Production PostgreSQL + pgvector:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bis_smartassist"
USE_PGVECTOR=false

# LLM Providers (Optional - Works 100% offline out-of-the-box with built-in factual synthesis)
# Set your Gemini or OpenAI API key here for external LLM generation:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="auto"
LLM_MODEL="gemini-1.5-flash"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
